# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.py

# Deliverable 1: built locally and submitted for Lab 2, not versioned.
# The Markdown sources in docs/ are the tracked record; the assembled Word
# file and its builder stay on the author's machine.
docs/deliverable-1/

# Keep future tracked Python tooling reachable despite the global *.py rule
!scripts/*.py

# ZCode agent configuration & local session data
.zcode/

# Graphify caches and local machine paths
graphify-out/.*
graphify-out/cache/
graphify-out/cost.json
.graphify-out/
graphify-out/

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
coverage/

# Environment files
.env
.env.local
.env.*.local
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS and Editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/

# Testing
playwright-report/
test-results/

# Other
*.pdf
