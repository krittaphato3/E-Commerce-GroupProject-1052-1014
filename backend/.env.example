# Omazon Environment Configuration
# Copy to backend/.env for local runs. Never commit the real .env file.
# Lines starting with "# NAME=value" are optional: uncommenting them changes behavior.

# ---- Server ----
# Port the API listens on (bound to 0.0.0.0). Cloud Run injects this itself.
PORT=3000
# development | test | production
NODE_ENV=development
# Browser origin allowed by CORS (the web frontend URL)
CLIENT_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL 16) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusbites?schema=public
# Used by the test suite and E2E only; the database name must end in _test
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusbites_test?schema=public

# ---- Sessions / auth ----
# Session lifetime in hours (sessions are stored in the database)
SESSION_TTL_HOURS=8
# Set true when served over HTTPS (production)
COOKIE_SECURE=false
# bcrypt cost, 4-15
BCRYPT_ROUNDS=10

# ---- Seed ----
# Demo accounts and sample menu: defaults to on locally and off when NODE_ENV=production.
# SEED_DEMO_DATA=false
# Passwords for the demo accounts (never commit real values)
SEED_CUSTOMER_PASSWORD=change-me-local
SEED_OPERATOR_PASSWORD=change-me-local

# ---- Frontend dev server (vite) ----
# Where the dev proxy forwards /api (default http://localhost:3000)
# API_PROXY_TARGET=http://localhost:3000

# ---- E2E (Playwright) and benchmark overrides ----
# E2E_CUSTOMER_EMAIL=customer1@campusbites.test
# E2E_OPERATOR_EMAIL=operator1@campusbites.test
# E2E_OTHER_CUSTOMER_EMAIL=customer2@campusbites.test
# E2E_FRONTEND_PORT=5174
# E2E_API_PORT=3100
# E2E_API_ORIGIN=http://localhost:3100
# E2E_BASE_URL=http://localhost:5174
# CAPTURE_EVIDENCE=1
# Base URL for the NFR-05 load benchmark
# BASE_URL=http://localhost:3100
