# CampusBites Environment Configuration

# Server
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusbites?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusbites_test?schema=public

# Session Authentication (production requires a unique secret of at least 32 characters)
SESSION_SECRET=local-development-session-secret-must-be-at-least-32-chars
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
BCRYPT_ROUNDS=10

# Database Seed Passwords (set local values in your own .env; never commit real passwords)
SEED_CUSTOMER_PASSWORD=change-me-local
SEED_OPERATOR_PASSWORD=change-me-local
