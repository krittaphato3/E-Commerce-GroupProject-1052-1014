# Omazon Environment Configuration
# Copy to backend/.env for local runs. Never commit the real .env file.
# Lines starting with "# NAME=value" are optional: uncommenting them changes behavior.

# ---- Server ----
# Port the API listens on (bound to 0.0.0.0). Cloud Run injects this itself.
PORT=3000
# development | test | production
NODE_ENV=development
# Browser origin allowed by CORS (the web frontend URL). Optional in production:
# when unset there, CORS is disabled (same-origin deployment).
CLIENT_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL 16) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusbites?schema=public
# Used by the test suite and E2E only; the database name must end in _test
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusbites_test?schema=public

# ---- Sessions / auth ----
# Session lifetime in hours (sessions are stored in the database)
SESSION_TTL_HOURS=8
# Defaults to true when NODE_ENV=production and false otherwise; an explicit value wins.
# Must be true behind HTTPS. Local http dev keeps it false.
COOKIE_SECURE=false
# bcrypt cost, 4-15
BCRYPT_ROUNDS=10

# ---- Seed ----
# Demo customers, extra operator and test-fixture menu items: defaults to on locally and
# off when NODE_ENV=production. Accepts true/false/1/0; any other value is an error.
# The first operator and the starter menu are always seeded. Seeding never overwrites
# existing users' passwords or existing menu items.
# SEED_DEMO_DATA=false
# Passwords for the demo accounts (never commit real values)
SEED_CUSTOMER_PASSWORD=change-me-local
SEED_OPERATOR_PASSWORD=change-me-local

# ---- E2E (Playwright) and benchmark overrides ----
# Read from this file by frontend/playwright.config.ts (process.loadEnvFile) and
# backend/benchmarks/nfr05-load.js (dotenv). Real shell variables take precedence.
# E2E_CUSTOMER_EMAIL=customer1@campusbites.test
# E2E_OPERATOR_EMAIL=operator1@campusbites.test
# E2E_OTHER_CUSTOMER_EMAIL=customer2@campusbites.test
# E2E_FRONTEND_PORT=5174
# E2E_API_PORT=3100
# E2E_API_ORIGIN=http://localhost:3100
# E2E_BASE_URL=http://localhost:5174
# CAPTURE_EVIDENCE=1
# Base URL for the NFR-05 load benchmark
# BASE_URL=http://localhost:3100

# NOTE: API_PROXY_TARGET (Vite dev proxy) is NOT read from this file. Set it in the
# shell instead, e.g.  API_PROXY_TARGET=http://localhost:8080 npm run dev:frontend
